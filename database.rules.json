{
  "rules": {
    "blogs": {
      ".read": "true",
      ".write": "auth != null"
    },
    "events": {
      ".read": "true",
      ".write": "auth != null"
    },
    "gallery": {
      ".read": "true",
      ".write": "auth != null"
    },
    "team": {
      ".read": "true",
      ".write": "auth != null"
    },
    "volunteers": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null || !data.exists()"
      }
    },
    "donations": {
      ".read": "auth != null",
      "$id": {
        ".write": "!data.exists() || (auth != null && newData.exists())"
      }
    },
    "contacts": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null || !data.exists()"
      }
    },
    "admins": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.email === 'owner@dayfoundation.com' || auth.token.email === 'mrshahidbabu@dayfoundation.in' || auth.token.email === 'info@dayfoundation.in')"
    },
    "audit_logs": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && !data.exists()"
      }
    },
    "settings": {
      ".write": "auth != null",
      "default_design_layout": {
        ".read": "true"
      },
      "recycle_bin_password": {
        ".read": "auth != null"
      }
    },
    "analytics": {
      ".read": "true",
      "visitors": {
        ".write": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() > data.val())"
      },
      "reach": {
        ".write": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() >= data.val())"
      }
    },
    "newsletter": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null || !data.exists()"
      }
    },
    "city_team": {
      ".read": "true",
      ".write": "auth != null"
    },
    "complaints": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null || !data.exists()"
      }
    },
    "testimonials": {
      ".read": "true",
      ".write": "auth != null"
    },
    "live_notification": {
      ".read": "true",
      ".write": "auth != null"
    }
  }
}
